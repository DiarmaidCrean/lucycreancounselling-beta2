<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Lucy Crean Counselling</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" type="image/jpeg" href="{{ '/assets/favicons/favicon-16x16.jpg' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/favicons/favicon-114x114.jpg' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
<body>

  <header id="site-header">
    <div class="container">
      <a href="{{ '/' | url }}" class="site-logo">Lucy Crean Counselling</a>

      <div class="header-right">
        <div class="header-contact">
          <a href="mailto:{{ sitedata.email }}">{{ sitedata.email }}</a>
          <a href="tel:{{ sitedata.phone | replace(' ', '') }}">{{ sitedata.phone }}</a>
        </div>
        <ul class="site-nav">
          <li><a href="{{ '/' | url }}">Home</a></li>
          <li><a href="{{ '/about/' | url }}">About</a></li>
          <li><a href="{{ '/my-approach/' | url }}">My Approach</a></li>
          <li><a href="{{ '/contact/' | url }}">Contact</a></li>
        </ul>
      </div>

      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile nav drawer -->
    <div class="mobile-nav" id="mobile-nav">
      <ul>
        <li><a href="{{ '/' | url }}">Home</a></li>
        <li><a href="{{ '/about/' | url }}">About</a></li>
        <li><a href="{{ '/my-approach/' | url }}">My Approach</a></li>
        <li><a href="{{ '/contact/' | url }}">Contact</a></li>
      </ul>
      <div class="mobile-nav-contact">
        <a href="mailto:{{ sitedata.email }}">{{ sitedata.email }}</a>
        <a href="tel:{{ sitedata.phone | replace(' ', '') }}">{{ sitedata.phone }}</a>
      </div>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer id="site-footer">
    <div class="footer-inner">
      <div class="footer-col footer-col--brand">
        <p class="footer-site-name">Lucy Crean Counselling</p>
        <p class="footer-tagline">Psychotherapeutic counsellor in Hove and online</p>
        <p class="footer-copyright">&copy; {% year %} Lucy Crean Counselling. All rights reserved.</p>
      </div>
      <div class="footer-col footer-col--links">
        <p class="footer-heading">Quick links</p>
        <ul class="footer-nav">
          <li><a href="{{ '/' | url }}">Home</a></li>
          <li><a href="{{ '/about/' | url }}">About</a></li>
          <li><a href="{{ '/my-approach/' | url }}">My Approach</a></li>
          <li><a href="{{ '/contact/' | url }}">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col footer-col--bacp">
        <a href="https://www.bacp.co.uk/therapists/150660/lucy-crean/hove-bn3" target="_blank" rel="noopener noreferrer">
          <img src="{{ '/assets/images/bacp-logo.png' | url }}" alt="BACP logo" class="bacp-logo">
        </a>
        <p class="footer-accredited">Accredited Member</p>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    toggle.addEventListener('click', function() {
      const open = mobileNav.classList.toggle('is-open');
      this.setAttribute('aria-expanded', open);
    });
  </script>


</body>
</html>
