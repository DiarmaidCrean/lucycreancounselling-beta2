<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Lucy Crean Counselling</title>
  <meta name="description" content="{{ description }}">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
<body>

  <header id="site-header">
    <div class="container">
      <a href="{{ '/' | url }}" class="site-logo">Lucy Crean Counselling</a>

      <div class="header-right">
        <div class="header-contact">
          <a href="mailto:lucy@lucycreancounselling.co.uk">lucy@lucycreancounselling.co.uk</a>
          <a href="tel:07947862832">07947 862832</a>
        </div>
        <ul class="site-nav">
          <li><a href="{{ '/' | url }}">Home</a></li>
          <li><a href="{{ '/about/' | url }}">About</a></li>
          <li><a href="{{ '/my-approach/' | url }}">My Approach</a></li>
          <li><a href="{{ '/contact/' | url }}">Contact</a></li>
        </ul>
      </div>

      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile nav drawer -->
    <div class="mobile-nav" id="mobile-nav">
      <ul>
        <li><a href="{{ '/' | url }}">Home</a></li>
        <li><a href="{{ '/about/' | url }}">About</a></li>
        <li><a href="{{ '/my-approach/' | url }}">My Approach</a></li>
        <li><a href="{{ '/contact/' | url }}">Contact</a></li>
      </ul>
      <div class="mobile-nav-contact">
        <a href="mailto:lucy@lucycreancounselling.co.uk">lucy@lucycreancounselling.co.uk</a>
        <a href="tel:07947862832">07947 862832</a>
      </div>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer id="site-footer">
    <div class="container">
      <p>&copy; {% year %} Lucy Crean Counselling. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    toggle.addEventListener('click', function() {
      const open = mobileNav.classList.toggle('is-open');
      this.setAttribute('aria-expanded', open);
    });
  </script>

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>

</body>
</html>
