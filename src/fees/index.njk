---
layout: base.njk
title: Fees & Booking
description: Fees and booking information for Lucy Crean Counselling in Hove. Sliding scale fees from £55-£65. Free 30-minute introductory call available.
---

{% set p = pages.fees %}

<section class="page-hero">
  <div class="container">
    <h1>{{ p.title }}</h1>
    <p>{{ p.subtitle }}</p>
  </div>
</section>

<section class="prose-section">
  <div class="container">
    <div class="prose">
      {{ p.body | markdownify | safe }}
      <div class="fees-contact">
        <p>Email: <a href="mailto:{{ sitedata.email }}">{{ sitedata.email }}</a></p>
        <p>Phone: <a href="tel:{{ sitedata.phone | replace(' ', '') }}">{{ sitedata.phone }}</a></p>
      </div>
      <a href="{{ '/contact/' | url }}" class="btn btn-dark">Get in touch</a>
    </div>
  </div>
</section>
