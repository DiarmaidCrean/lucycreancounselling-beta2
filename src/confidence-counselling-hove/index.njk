---js
{
  layout: "base.njk",
  title: "Confidence and Self Esteem Counselling Hove",
  description: "Counselling for low confidence and self esteem with Lucy Crean in Hove, Brighton.",
  eleventyComputed: {
    // Built only when "Ready to publish" is ticked in the CMS. A real boolean false
    // tells Eleventy not to write the page at all, so the URL returns a 404.
    permalink: (data) => (data.pages.confidence_counselling.ready === true ? "/confidence-counselling-hove/" : false)
  }
}
---

{% set p = pages.confidence_counselling %}

<section class="page-hero">
  <div class="container">
    <h1>{{ p.title }}</h1>
    <p>{{ p.subtitle }}</p>
  </div>
</section>

<section class="prose-section">
  <div class="container">
    <div class="prose">
      {{ p.body | markdownify | safe }}
      <a href="{{ '/contact/' | url }}" class="btn btn-dark">Book a free introductory call</a>
    </div>
  </div>
</section>
