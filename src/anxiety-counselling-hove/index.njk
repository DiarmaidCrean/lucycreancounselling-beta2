---js
{
  layout: "base.njk",
  title: "Anxiety Counselling Hove",
  description: "Counselling for anxiety and emotional overwhelm with Lucy Crean in Hove, Brighton.",
  eleventyComputed: {
    // Built only when "Ready to publish" is ticked in the CMS. A real boolean false
    // tells Eleventy not to write the page at all, so the URL returns a 404.
    permalink: (data) => (data.pages.anxiety_counselling.ready === true ? "/anxiety-counselling-hove/" : false)
  }
}
---

{% set p = pages.anxiety_counselling %}

<section class="page-hero">
  <div class="container">
    <h1>{{ p.title }}</h1>
    <p>{{ p.subtitle }}</p>
  </div>
</section>

<section class="prose-section">
  <div class="container">
    <div class="prose">
      {{ p.body | markdownify | safe }}
      <a href="{{ '/contact/' | url }}" class="btn btn-dark">Book a free introductory call</a>
    </div>
  </div>
</section>
