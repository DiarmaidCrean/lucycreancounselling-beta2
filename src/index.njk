---
layout: base.njk
title: Psychotherapeutic Counselling in Hove
description: Experienced counsellor in Brighton and Hove BN3, offering psychotherapeutic counselling for anxiety, postnatal issues, menopause, relationship difficulties, grief and bereavement.
---

{% set p = pages.homepage %}

<!-- 1. Hero -->
<section class="hero">
  <div class="container">
    <h1>{{ p.title }}</h1>
    <p>{{ p.subtitle }}</p>
    <a href="{{ '/contact/' | url }}" class="btn btn-outline">Get in touch</a>
  </div>
</section>

<!-- 2. Welcome -->
<section class="welcome">
  <div class="container">
    <div class="two-col welcome-two-col">
      <div class="welcome-text">
        <h2>Welcome</h2>
        {{ p.body | markdownify | safe }}
        <a href="{{ '/about/' | url }}" class="btn btn-dark">More about me</a>
      </div>
      <div class="welcome-photo-col">
        <img src="{{ p.photo | url }}" alt="Lucy Crean, counsellor in Hove" class="welcome-photo">
      </div>
    </div>
  </div>
</section>

<!-- 3. How can counselling support you -->
<section class="support-split">
  <div class="support-split__image">
    <p class="support-split__overlay">{{ p.support_quote }}</p>
  </div>
  <div class="support-split__text">
    <div>
      <h2>{{ p.support_heading }}</h2>
      <p>{{ p.support_text }}</p>
      <a href="{{ '/my-approach/' | url }}" class="btn btn-outline">My approach</a>
    </div>
  </div>
</section>

<!-- 4. Conditions -->
<section class="conditions">
  <div class="container">
    <h2>{{ p.conditions_heading }}</h2>
    <div class="conditions-grid">

      <div class="condition-item">
        <h3>{{ pages.postnatal_counselling.title }}</h3>
        <hr>
        <p>{{ pages.postnatal_counselling.body | striptags | truncate(120) }}</p>
        <a href="{{ '/postnatal-counselling-hove/' | url }}" class="read-more">Read More &rsaquo;</a>
      </div>

      <div class="condition-item">
        <h3>{{ pages.menopause_counselling.title }}</h3>
        <hr>
        <p>{{ pages.menopause_counselling.body | striptags | truncate(120) }}</p>
        <a href="{{ '/menopause-counselling-hove/' | url }}" class="read-more">Read More &rsaquo;</a>
      </div>

      <div class="condition-item">
        <h3>{{ pages.relationship_counselling.title }}</h3>
        <hr>
        <p>{{ pages.relationship_counselling.body | striptags | truncate(120) }}</p>
        <a href="{{ '/relationship-counselling-hove/' | url }}" class="read-more">Read More &rsaquo;</a>
      </div>

      <div class="condition-item">
        <h3>{{ pages.anxiety_counselling.title }}</h3>
        <hr>
        <p>{{ pages.anxiety_counselling.body | striptags | truncate(120) }}</p>
        <a href="{{ '/anxiety-counselling-hove/' | url }}" class="read-more">Read More &rsaquo;</a>
      </div>

      <div class="condition-item">
        <h3>{{ pages.confidence_counselling.title }}</h3>
        <hr>
        <p>{{ pages.confidence_counselling.body | striptags | truncate(120) }}</p>
        <a href="{{ '/confidence-counselling-hove/' | url }}" class="read-more">Read More &rsaquo;</a>
      </div>

      <div class="condition-item">
        <h3>{{ pages.grief_counselling.title }}</h3>
        <hr>
        <p>{{ pages.grief_counselling.body | striptags | truncate(120) }}</p>
        <a href="{{ '/grief-counselling-hove/' | url }}" class="read-more">Read More &rsaquo;</a>
      </div>

    </div>
  </div>
</section>

<!-- 5. Contact -->
<section class="contact-section">
  <div class="container">
    <div class="two-col">
      <div>
        <h2>{{ p.contact_heading }}</h2>
        <p class="subheading">{{ p.contact_subheading }}</p>
        <form action="https://formspree.io/f/xkoawezq" method="POST">
          <input type="hidden" name="_subject" value="New enquiry from Lucy Crean Counselling">
          <div class="form-grid">
            <div class="form-group">
              <label for="first-name">First name</label>
              <input type="text" id="first-name" name="first_name" autocomplete="given-name" required>
            </div>
            <div class="form-group">
              <label for="last-name">Last name</label>
              <input type="text" id="last-name" name="last_name" autocomplete="family-name" required>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel">
            </div>
            <div class="form-group full">
              <label for="message">Message</label>
              <textarea id="message" name="message" autocomplete="off"></textarea>
            </div>
          </div>
          <div class="form-submit">
            <button type="submit" class="btn btn-dark">Send message</button>
          </div>
        </form>
      </div>
      <div class="contact-details">
        <h3>Contact details</h3>
        <p>Email: <a href="mailto:{{ sitedata.email }}">{{ sitedata.email }}</a></p>
        <p>Phone: <a href="tel:{{ sitedata.phone | replace(' ', '') }}">{{ sitedata.phone }}</a></p>
        <p>Location: {{ sitedata.address }}</p>
      </div>
    </div>
  </div>
</section>
