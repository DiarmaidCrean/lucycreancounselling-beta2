---
layout: base.njk
title: About Lucy Crean
description: Lucy Crean is a BACP Accredited counsellor in Hove, offering psychotherapeutic counselling for a wide range of personal difficulties.
---

{% set p = pages.about %}

<section class="page-hero">
  <div class="container">
    <h1>{{ p.title }}</h1>
    <p>{{ p.subtitle }}</p>
  </div>
</section>

<section class="prose-section">
  <div class="container">
    <div class="two-col">
      <div>
        <img src="{{ p.photo | url }}" alt="Lucy Crean, counsellor in Hove" class="welcome-photo">
      </div>
      <div class="prose">
        {{ p.body_top | markdownify | safe }}
      </div>
    </div>
  </div>
</section>

<section class="testimonial-block">
  <blockquote class="testimonial-quote">
    <p>&ldquo;{{ p.testimonial_text }}&rdquo;</p>
    <footer class="testimonial-attribution">&mdash; {{ p.testimonial_attribution }}</footer>
  </blockquote>
</section>

<section class="prose-section prose-section--no-top">
  <div class="container">
    <div class="prose">
      {{ p.body_bottom | markdownify | safe }}
      <a href="{{ '/contact/' | url }}" class="btn btn-dark">Get in touch</a>
    </div>
  </div>
</section>
